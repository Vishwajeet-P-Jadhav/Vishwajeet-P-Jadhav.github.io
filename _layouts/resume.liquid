---
layout: default
---
{% assign resume = site.data.resume %}

<style>
/* Custom CSS for a cleaner look */
.resume-section-divider {
    border: 0;
    height: 1px;
    background-image: linear-gradient(to right, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0));
    margin-top: 0.5rem;
    margin-bottom: 1.5rem;
}
.experience-card {
    border-left: 4px solid #007bff; /* Accent color for the left border */
    transition: transform 0.2s, box-shadow 0.2s;
    border-radius: 0.25rem;
    margin-bottom: 1.5rem;
}
.experience-card:hover {
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important; /* Subtle lift on hover */
    transform: translateY(-2px);
}
.card-header-custom {
    background-color: #f8f9fa; /* Light background for the header */
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    padding-bottom: 0.5rem;
}
.highlight-list li {
    padding-left: 0.5rem;
    margin-bottom: 0.25rem;
}
</style>

<div class="post">

  <header class="post-header mb-4 pb-2 border-bottom">
    <h1 class="post-title display-4 font-weight-bold mb-1">{{ resume.basics.name }}</h1>
    <p class="lead text-muted">
      {% if resume.basics.email %}
        <i class="far fa-envelope mr-1" aria-hidden="true"></i>
        <a href="mailto:{{ resume.basics.email }}">{{ resume.basics.email }}</a>
        &nbsp;&nbsp;&middot;&nbsp;&nbsp;
      {% endif %}

      {% if resume.basics.profiles %}
        {% for profile in resume.basics.profiles %}
          {% if profile.network == "LinkedIn" %}
            <i class="fab fa-linkedin mr-1" aria-hidden="true"></i>
            <a href="{{ profile.url }}" target="_blank">LinkedIn</a>
            &nbsp;&nbsp;&middot;&nbsp;&nbsp;
          {% elsif profile.network == "Website" %}
            <i class="fas fa-globe mr-1" aria-hidden="true"></i>
            <a href="{{ profile.url }}" target="_blank">Website</a>
            &nbsp;&nbsp;&middot;&nbsp;&nbsp;
          {% endif %}
        {% endfor %}
      {% endif %}
      
      <i class="fas fa-map-marker-alt mr-1" aria-hidden="true"></i>
      {{ resume.basics.location }}
    </p>

    {% comment %} PDF Download Button Code Restored Here {% endcomment %}
    {% if page.cv_pdf %}
      <a href="{{ page.cv_pdf | prepend: '/assets/pdf/' | relative_url }}" target="_blank" class="btn btn-sm btn-primary mt-2">
        <i class="fas fa-file-pdf mr-2"></i> Download PDF
      </a>
    {% endif %}
    
  </header>

  <article>

    {% comment %} Education Section {% endcomment %}
    {% if resume.education.size > 0 %}
    <h2 class="year mt-4">Education</h2>
    <hr class="resume-section-divider">
    {% for edu in resume.education %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          <div class="row align-items-center">
            <div class="col-sm-8">
              <h5 class="card-title font-weight-bold mb-0">{{ edu.institution }}</h5>
              <p class="card-subtitle text-muted mb-0">{{ edu.studyType }} in {{ edu.area }}</p>
            </div>
            <div class="col-sm-4 text-right">
              <p class="card-text text-muted mb-0">{{ edu.startDate }} – {{ edu.endDate }}</p>
            </div>
          </div>
        </div>
        <div class="card-body py-3">
          {% if edu.highlights %}
            <ul class="highlight-list list-unstyled">
            {% for highlight in edu.highlights %}
              <li><i class="fas fa-caret-right text-primary mr-2"></i> {{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Work/Internship Section {% endcomment %}
    {% if resume.work.size > 0 %}
    <h2 class="year mt-4">Research Internship</h2>
    <hr class="resume-section-divider">
    {% for work in resume.work %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          <div class="row align-items-center">
            <div class="col-sm-8">
              <h5 class="card-title font-weight-bold mb-0">{{ work.position }}</h5>
              <p class="card-subtitle text-muted mb-0">{{ work.name }}</p>
            </div>
            <div class="col-sm-4 text-right">
              <p class="card-text text-muted mb-0">{{ work.startDate }} – {{ work.endDate }}</p>
            </div>
          </div>
        </div>
        <div class="card-body py-3">
          {% if work.highlights %}
            <ul class="highlight-list list-unstyled">
            {% for highlight in work.highlights %}
              <li><i class="fas fa-caret-right text-primary mr-2"></i> {{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Projects/Research Experience Section {% endcomment %}
    {% if resume.projects.size > 0 %}
    <h2 class="year mt-4">Research & Academic Projects</h2>
    <hr class="resume-section-divider">
    {% for project in resume.projects %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          <div class="row align-items-center">
            <div class="col-sm-8">
              <h5 class="card-title font-weight-bold mb-0">{{ project.title }}</h5>
              <p class="card-subtitle text-muted mb-0">{{ project.organization }}</p>
            </div>
            <div class="col-sm-4 text-right">
              <p class="card-text text-muted mb-0">
                {% if project.startDate %}{{ project.startDate }}{% endif %}
                {% if project.endDate %} – {{ project.endDate }}{% endif %}
              </p>
            </div>
          </div>
        </div>
        <div class="card-body py-3">
          {% if project.highlights %}
            <ul class="highlight-list list-unstyled">
            {% for highlight in project.highlights %}
              <li><i class="fas fa-caret-right text-primary mr-2"></i> {{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Academic Achievements Section {% endcomment %}
    {% if resume.awards.size > 0 %}
    <h2 class="year mt-4">Academic Achievements</h2>
    <hr class="resume-section-divider">
      <ul class="highlight-list list-unstyled">
      {% for award in resume.awards %}
        <li class="mb-2">
          <i class="fas fa-trophy text-warning mr-2"></i>
          {% if award.url %}
            <a href="{{ award.url }}" target="_blank">
          {% endif %}
          <strong>{{ award.title }}</strong>
          {% if award.url %}
            </a>
          {% endif %}
          {% if award.date %}({{ award.date }}){% endif %}
          {% if award.summary %}: {{ award.summary | markdownify }}{% endif %}
        </li>
      {% endfor %}
      </ul>
    {% endif %}

    {% comment %} Skills Section {% endcomment %}
    {% if resume.skills.size > 0 %}
    <h2 class="year mt-4">Skills</h2>
    <hr class="resume-section-divider">
      <ul class="list-unstyled">
      {% for skill in resume.skills %}
        <li class="mb-2">
          <strong>{{ skill.name }}:</strong> {{ skill.keywords | join: ", " }}
        </li>
      {% endfor %}
      </ul>
    {% endif %}

  </article>

</div>