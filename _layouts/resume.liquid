---
layout: default
---
{% assign resume = site.data.resume %}

<style>
/* Custom CSS for final aesthetic, compact, and clean look */

/* 1. Name Font Size Reduction & Header Cleanup */
.post-title-custom {
    font-size: 2.25rem !important; /* Smaller than previous 2.5rem */
    font-weight: bold;
    margin-bottom: 0; /* Remove bottom margin */
    padding-bottom: 0; /* Remove bottom padding */
}
.header-details-compact {
    display: none; /* Hides all contact details and icons in the resume header */
}
.post-header {
    margin-bottom: 1.5rem !important;
    padding-bottom: 0.5rem !important;
}

/* 2. Tighter Bullet Points and Alignment (Main Fix) */
.highlight-list li {
    font-size: 0.85rem; /* Smallest content font size for maximum compactness */
    padding-left: 0rem;
    margin-bottom: 0rem; /* ELIMINATED all vertical space between bullets */
    line-height: 1.35; /* Tighter line height */
    position: relative;
    /* Ensure text aligns horizontally with the icon, no forced line wrap */
    padding-left: 1.5em; /* Space for the icon */
    text-indent: -1.5em; /* Pulls the icon back */
}
.highlight-list li .fas {
    margin-right: 0.5em; /* Space between icon and text */
}

/* 3. General Compactness (reduced padding/margins) */
.resume-section-divider {
    margin-top: 0.5rem;
    margin-bottom: 0.8rem; /* Further reduced vertical space */
}
.experience-card {
    margin-bottom: 0.8rem; /* Reduced space between cards */
}
.card-header-custom {
    padding: 0.4rem 1rem; /* Reduced padding */
}
.card-body {
    padding: 0.6rem 1rem; /* Reduced padding */
}
.card-title, .card-subtitle, .card-text {
    font-size: 0.95rem !important; /* Smaller text in card headers */
}
</style>

<div class="post">

  <header class="post-header mb-3 pb-1 border-bottom">
    <h1 class="post-title-custom mb-1">{{ resume.basics.name }}</h1>
    
    {% comment %} 
    Removed contact details (email, LinkedIn, location) as requested 
    The post-description div is hidden via CSS class .header-details-compact
    {% endcomment %}
    <p class="header-details-compact">
      {{ resume.basics.email }} | {{ resume.basics.location }}
    </p>

    {% comment %} PDF Download Button Code Retained {% endcomment %}
    {% if page.cv_pdf %}
      <a href="{{ page.cv_pdf | prepend: '/assets/pdf/' | relative_url }}" target="_blank" class="btn btn-sm btn-primary mt-1">
        <i class="fas fa-file-pdf mr-2"></i> Download PDF
      </a>
    {% endif %}
    
  </header>

  <article>

    {% comment %} Education Section {% endcomment %}
    {% if resume.education.size > 0 %}
    <h2 class="year mt-3">Education</h2>
    <hr class="resume-section-divider">
    {% for edu in resume.education %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          <div class="row align-items-center">
            <div class="col-sm-8">
              <h5 class="card-title font-weight-bold mb-0">{{ edu.institution }}</h5>
              <p class="card-subtitle mb-0">{{ edu.studyType }} in {{ edu.area }}</p>
            </div>
            <div class="col-sm-4 text-right">
              <p class="card-text mb-0">{{ edu.startDate }} – {{ edu.endDate }}</p>
            </div>
          </div>
        </div>
        <div class="card-body py-3">
          {% if edu.highlights %}
            <ul class="highlight-list list-unstyled">
            {% for highlight in edu.highlights %}
              <li><i class="fas fa-caret-right text-primary"></i> {{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Research Internship Section {% endcomment %}
    {% if resume.work.size > 0 %}
    <h2 class="year mt-3">Research Internship</h2>
    <hr class="resume-section-divider">
    {% for work in resume.work %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          <div class="row align-items-center">
            <div class="col-sm-8">
              <h5 class="card-title font-weight-bold mb-0">{{ work.position }}</h5>
              <p class="card-subtitle mb-0">{{ work.name }}</p>
            </div>
            <div class="col-sm-4 text-right">
              <p class="card-text mb-0">{{ work.startDate }} – {{ work.endDate }}</p>
            </div>
          </div>
        </div>
        <div class="card-body py-3">
          {% if work.highlights %}
            <ul class="highlight-list list-unstyled">
            {% for highlight in work.highlights %}
              <li><i class="fas fa-caret-right text-primary"></i> {{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Projects/Research Experience Section {% endcomment %}
    {% if resume.projects.size > 0 %}
    <h2 class="year mt-3">Research & Academic Projects</h2>
    <hr class="resume-section-divider">
    {% for project in resume.projects %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          <div class="row align-items-center">
            <div class="col-sm-8">
              <h5 class="card-title font-weight-bold mb-0">{{ project.title }}</h5>
              <p class="card-subtitle mb-0">{{ project.organization }}</p>
            </div>
            <div class="col-sm-4 text-right">
              <p class="card-text mb-0">
                {% if project.startDate %}{{ project.startDate }}{% endif %}
                {% if project.endDate %} – {{ project.endDate }}{% endif %}
              </p>
            </div>
          </div>
        </div>
        <div class="card-body py-3">
          {% if project.highlights %}
            <ul class="highlight-list list-unstyled">
            {% for highlight in project.highlights %}
              <li><i class="fas fa-caret-right text-primary"></i> {{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Academic Achievements Section (Icons removed, compact spacing) {% endcomment %}
    {% if resume.awards.size > 0 %}
    <h2 class="year mt-3">Academic Achievements</h2>
    <hr class="resume-section-divider">
      <ul class="highlight-list list-unstyled">
      {% for award in resume.awards %}
        <li class="mb-0">
          {% if award.url %}
            <a href="{{ award.url }}" target="_blank">
          {% endif %}
          <strong>{{ award.title }}</strong>
          {% if award.url %}
            </a>
          {% endif %}
          {% if award.date %}({{ award.date }}){% endif %}
          {% if award.summary %}: {{ award.summary | markdownify }}{% endif %}
        </li>
      {% endfor %}
      </ul>
    {% endif %}

    {% comment %} Skills Section {% endcomment %}
    {% if resume.skills.size > 0 %}
    <h2 class="year mt-3">Skills</h2>
    <hr class="resume-section-divider">
      <ul class="list-unstyled">
      {% for skill in resume.skills %}
        <li class="mb-1" style="font-size: 0.85rem;">
          <strong>{{ skill.name }}:</strong> {{ skill.keywords | join: ", " }}
        </li>
      {% endfor %}
      </ul>
    {% endif %}

  </article>

</div>