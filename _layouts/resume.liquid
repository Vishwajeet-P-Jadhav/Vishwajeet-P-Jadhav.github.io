---
layout: default
---
{% assign resume = site.data.resume %}

<style>
/* Custom CSS for a compact, dark-mode friendly look */

/* 1. Name Font Size Reduction */
.post-title-custom {
    font-size: 2.5rem !important; /* Reduced from 3.5rem or 4rem */
    font-weight: bold;
    margin-bottom: 0.5rem;
}

/* 2. Consistent Title/Subtitle Color & Font Sizes */
.experience-card .card-header-custom h5, 
.experience-card .card-header-custom p.card-subtitle {
    color: inherit !important; /* Forces text to use theme's default color (works for dark/light mode) */
    font-size: 1rem; /* Standard title size */
}
.experience-card .card-header-custom p.card-subtitle {
    font-size: 0.95rem; /* Slightly smaller subtitle for hierarchy */
}

/* 3. General Aesthetics */
.resume-section-divider {
    border: 0;
    height: 1px;
    background-image: linear-gradient(to right, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0));
    margin-top: 0.5rem;
    margin-bottom: 1rem; /* Reduced space */
}
.experience-card {
    border-left: 4px solid var(--global-theme-color); /* Uses theme primary color */
    transition: transform 0.2s, box-shadow 0.2s;
    border-radius: 0.25rem;
    margin-bottom: 1rem; /* Reduced space between cards */
}
.experience-card:hover {
    box-shadow: 0 0.25rem 0.5rem rgba(0, 0, 0, 0.15) !important; /* Reduced lift/shadow */
    transform: translateY(-1px);
}
.card-header-custom {
    background-color: var(--global-divider-color, #f8f9fa); /* Uses a theme variable for compatibility */
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    padding: 0.5rem 1.25rem; /* Reduced padding */
}
.card-body {
    padding: 0.75rem 1.25rem; /* Reduced padding */
}
/* 4. Tighter Bullet Points and Smaller Font for Content */
.highlight-list li {
    font-size: 0.9rem; /* Reduced content font size */
    padding-left: 0rem;
    margin-bottom: 0.1rem; /* Minimized vertical space between bullets */
    line-height: 1.4;
}
.highlight-list .fa-caret-right {
    display: inline; /* Ensure icon doesn't force a line break */
}
.year {
    margin-bottom: 0.5rem; /* Tighten space above sections */
}
.post-description a, .post-description i {
    font-size: 0.95rem; /* Slightly reduced header details font size */
}

</style>

<div class="post">

  <header class="post-header mb-3 pb-1 border-bottom">
    <h1 class="post-title-custom mb-1">{{ resume.basics.name }}</h1>
    <p class="lead text-muted">
      {% comment %} Contact Details with custom size {% endcomment %}
      {% if resume.basics.email %}
        <i class="far fa-envelope mr-1" aria-hidden="true"></i>
        <a href="mailto:{{ resume.basics.email }}">{{ resume.basics.email }}</a>
        &nbsp;&nbsp;&middot;&nbsp;&nbsp;
      {% endif %}

      {% if resume.basics.profiles %}
        {% for profile in resume.basics.profiles %}
          {% if profile.network == "LinkedIn" %}
            <i class="fab fa-linkedin mr-1" aria-hidden="true"></i>
            <a href="{{ profile.url }}" target="_blank">LinkedIn</a>
            &nbsp;&nbsp;&middot;&nbsp;&nbsp;
          {% elsif profile.network == "Website" %}
            <i class="fas fa-globe mr-1" aria-hidden="true"></i>
            <a href="{{ profile.url }}" target="_blank">Website</a>
            &nbsp;&nbsp;&middot;&nbsp;&nbsp;
          {% endif %}
        {% endfor %}
      {% endif %}
      
      <i class="fas fa-map-marker-alt mr-1" aria-hidden="true"></i>
      {{ resume.basics.location }}
    </p>

    {% comment %} PDF Download Button Code Restored {% endcomment %}
    {% if page.cv_pdf %}
      <a href="{{ page.cv_pdf | prepend: '/assets/pdf/' | relative_url }}" target="_blank" class="btn btn-sm btn-primary mt-1">
        <i class="fas fa-file-pdf mr-2"></i> Download PDF
      </a>
    {% endif %}
    
  </header>

  <article>

    {% comment %} Education Section {% endcomment %}
    {% if resume.education.size > 0 %}
    <h2 class="year mt-3">Education</h2>
    <hr class="resume-section-divider">
    {% for edu in resume.education %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          <div class="row align-items-center">
            <div class="col-sm-8">
              <h5 class="card-title font-weight-bold mb-0">{{ edu.institution }}</h5>
              <p class="card-subtitle mb-0">{{ edu.studyType }} in {{ edu.area }}</p>
            </div>
            <div class="col-sm-4 text-right">
              <p class="card-text mb-0">{{ edu.startDate }} – {{ edu.endDate }}</p>
            </div>
          </div>
        </div>
        <div class="card-body py-3">
          {% if edu.highlights %}
            <ul class="highlight-list list-unstyled">
            {% for highlight in edu.highlights %}
              <li><i class="fas fa-caret-right text-primary mr-2"></i> {{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Research Internship Section {% endcomment %}
    {% if resume.work.size > 0 %}
    <h2 class="year mt-3">Research Internship</h2>
    <hr class="resume-section-divider">
    {% for work in resume.work %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          <div class="row align-items-center">
            <div class="col-sm-8">
              <h5 class="card-title font-weight-bold mb-0">{{ work.position }}</h5>
              <p class="card-subtitle mb-0">{{ work.name }}</p>
            </div>
            <div class="col-sm-4 text-right">
              <p class="card-text mb-0">{{ work.startDate }} – {{ work.endDate }}</p>
            </div>
          </div>
        </div>
        <div class="card-body py-3">
          {% if work.highlights %}
            <ul class="highlight-list list-unstyled">
            {% for highlight in work.highlights %}
              <li><i class="fas fa-caret-right text-primary mr-2"></i> {{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Projects/Research Experience Section {% endcomment %}
    {% if resume.projects.size > 0 %}
    <h2 class="year mt-3">Research & Academic Projects</h2>
    <hr class="resume-section-divider">
    {% for project in resume.projects %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          <div class="row align-items-center">
            <div class="col-sm-8">
              <h5 class="card-title font-weight-bold mb-0">{{ project.title }}</h5>
              <p class="card-subtitle mb-0">{{ project.organization }}</p>
            </div>
            <div class="col-sm-4 text-right">
              <p class="card-text mb-0">
                {% if project.startDate %}{{ project.startDate }}{% endif %}
                {% if project.endDate %} – {{ project.endDate }}{% endif %}
              </p>
            </div>
          </div>
        </div>
        <div class="card-body py-3">
          {% if project.highlights %}
            <ul class="highlight-list list-unstyled">
            {% for highlight in project.highlights %}
              <li><i class="fas fa-caret-right text-primary mr-2"></i> {{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Academic Achievements Section (Icons removed) {% endcomment %}
    {% if resume.awards.size > 0 %}
    <h2 class="year mt-3">Academic Achievements</h2>
    <hr class="resume-section-divider">
      <ul class="highlight-list list-unstyled">
      {% for award in resume.awards %}
        <li class="mb-2">
          {% if award.url %}
            <a href="{{ award.url }}" target="_blank">
          {% endif %}
          <strong>{{ award.title }}</strong>
          {% if award.url %}
            </a>
          {% endif %}
          {% if award.date %}({{ award.date }}){% endif %}
          {% if award.summary %}: {{ award.summary | markdownify }}{% endif %}
        </li>
      {% endfor %}
      </ul>
    {% endif %}

    {% comment %} Skills Section {% endcomment %}
    {% if resume.skills.size > 0 %}
    <h2 class="year mt-3">Skills</h2>
    <hr class="resume-section-divider">
      <ul class="list-unstyled">
      {% for skill in resume.skills %}
        <li class="mb-1" style="font-size: 0.9rem;">
          <strong>{{ skill.name }}:</strong> {{ skill.keywords | join: ", " }}
        </li>
      {% endfor %}
      </ul>
    {% endif %}

  </article>

</div>