---
layout: default
---
{% assign resume = site.data.resume %}

<div class="post">

  <header class="post-header">
    <h1 class="post-title">{{ resume.basics.name }}</h1>
    <p class="post-description">
      {% if resume.basics.email %}
        <i class="far fa-envelope" aria-hidden="true"></i>
        <a href="mailto:{{ resume.basics.email }}">{{ resume.basics.email }}</a>
        &nbsp;&nbsp;&middot;&nbsp;&nbsp;
      {% endif %}

      {% if resume.basics.profiles %}
        {% for profile in resume.basics.profiles %}
          {% if profile.network == "LinkedIn" %}
            <i class="fab fa-linkedin" aria-hidden="true"></i>
            <a href="{{ profile.url }}">LinkedIn</a>
            &nbsp;&nbsp;&middot;&nbsp;&nbsp;
          {% elsif profile.network == "Website" %}
            <i class="fas fa-globe" aria-hidden="true"></i>
            <a href="{{ profile.url }}">Website</a>
            &nbsp;&nbsp;&middot;&nbsp;&nbsp;
          {% endif %}
        {% endfor %}
      {% endif %}
      
      <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
      {{ resume.basics.location }}
    </p>
  </header>

  <article>

    {% comment %} Education Section {% endcomment %}
    {% if resume.education.size > 0 %}
    <h2 class="year">Education</h2>
    {% for edu in resume.education %}
      <div class="card mt-3">
        <div class="card-body">
          <div class="row">
            <div class="col-8">
              <h5 class="card-title font-weight-bold mb-1">{{ edu.institution }}</h5>
              <h6 class="card-subtitle font-weight-bold mb-1">{{ edu.studyType }} in {{ edu.area }}</h6>
            </div>
            <div class="col-4 text-right">
              <p class="card-text">{{ edu.startDate }} – {{ edu.endDate }}</p>
            </div>
          </div>
          {% if edu.highlights %}
            <ul class="resume-list">
            {% for highlight in edu.highlights %}
              <li>{{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Work/Internship Section {% endcomment %}
    {% if resume.work.size > 0 %}
    <h2 class="year">Research Internship</h2>
    {% for work in resume.work %}
      <div class="card mt-3">
        <div class="card-body">
          <div class="row">
            <div class="col-8">
              <h5 class="card-title font-weight-bold mb-1">{{ work.position }}</h5>
              <h6 class="card-subtitle mb-1">{{ work.name }}</h6>
            </div>
            <div class="col-4 text-right">
              <p class="card-text">{{ work.startDate }} – {{ work.endDate }}</p>
            </div>
          </div>
          {% if work.highlights %}
            <ul class="resume-list">
            {% for highlight in work.highlights %}
              <li>{{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Projects/Research Experience Section (Mapped from projects array) {% endcomment %}
    {% if resume.projects.size > 0 %}
    <h2 class="year">Research & Academic Projects</h2>
    {% for project in resume.projects %}
      <div class="card mt-3">
        <div class="card-body">
          <div class="row">
            <div class="col-8">
              <h5 class="card-title font-weight-bold mb-1">{{ project.title }}</h5>
              <h6 class="card-subtitle mb-1">{{ project.organization }}</h6>
            </div>
            <div class="col-4 text-right">
              <p class="card-text">
                {% if project.startDate %}{{ project.startDate }}{% endif %}
                {% if project.endDate %} – {{ project.endDate }}{% endif %}
              </p>
            </div>
          </div>
          {% if project.highlights %}
            <ul class="resume-list">
            {% for highlight in project.highlights %}
              <li>{{ highlight | markdownify }}</li>
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Academic Achievements Section {% endcomment %}
    {% if resume.awards.size > 0 %}
    <h2 class="year">Academic Achievements</h2>
      <ul class="resume-list">
      {% for award in resume.awards %}
        <li>
          {% if award.url %}
            <a href="{{ award.url }}" target="_blank">
          {% endif %}
          <strong>{{ award.title }}</strong>
          {% if award.url %}
            </a>
          {% endif %}
          {% if award.date %}({{ award.date }}){% endif %}
          {% if award.summary %}: {{ award.summary | markdownify }}{% endif %}
        </li>
      {% endfor %}
      </ul>
    {% endif %}

    {% comment %} Skills Section {% endcomment %}
    {% if resume.skills.size > 0 %}
    <h2 class="year">Skills</h2>
      <ul class="list-unstyled">
      {% for skill in resume.skills %}
        <li><strong>{{ skill.name }}:</strong> {{ skill.keywords | join: ", " }}</li>
      {% endfor %}
      </ul>
    {% endif %}

  </article>

</div>