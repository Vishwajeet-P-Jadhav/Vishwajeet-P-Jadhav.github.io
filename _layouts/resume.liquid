---
layout: default
---
{% assign resume = site.data.resume %}

<style>
/* Custom CSS for final aesthetic, compact, and clean look */

/* 1. Name Font Size Reduction & Header Cleanup (Remaining as before) */
.post-title-custom {
    font-size: 2.25rem !important;
    font-weight: bold;
    margin-bottom: 0;
    padding-bottom: 0;
}
.header-details-compact {
    display: none;
}
/* ... (rest of the non-bullet CSS) ... */

/* 2. Tighter Bullet Points and Alignment (Updated) */
.highlight-list li {
    font-size: 0.85rem;
    padding-left: 0rem;
    margin-bottom: 0rem; 
    line-height: 1.35;
    position: relative;
    /* Reset indentation to use simple list bullets */
    padding-left: 1.5em; 
    text-indent: -1.5em; 
    list-style-type: disc; /* Use standard disc bullet point */
}
/* REMOVED: .highlight-list li .fas { ... } to stop rendering the icons */
.highlight-list {
    padding-left: 1.5em; /* Ensure the list itself has some left margin */
}
.highlight-list li .fas {
    display: none; /* Explicitly hide the icons */
}
/* ... (rest of the CSS) ... */

</style>

<div class="post">
  <article>

    {% comment %} Education Section {% endcomment %}
    {% if resume.education.size > 0 %}
    <h2 class="year mt-3">Education</h2>
    <hr class="resume-section-divider">
    {% for edu in resume.education %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          </div>
        <div class="card-body py-3">
          {% if edu.highlights %}
            <ul class="highlight-list">  <-- Removed list-unstyled
            {% for highlight in edu.highlights %}
              <li> {{ highlight | markdownify }}</li>  <-- Removed icon Liquid
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Research Internship Section {% endcomment %}
    {% if resume.work.size > 0 %}
    <h2 class="year mt-3">Research Internship</h2>
    <hr class="resume-section-divider">
    {% for work in resume.work %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          </div>
        <div class="card-body py-3">
          {% if work.highlights %}
            <ul class="highlight-list">  <-- Removed list-unstyled
            {% for highlight in work.highlights %}
              <li> {{ highlight | markdownify }}</li>  <-- Removed icon Liquid
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Projects/Research Experience Section {% endcomment %}
    {% if resume.projects.size > 0 %}
    <h2 class="year mt-3">Research & Academic Projects</h2>
    <hr class="resume-section-divider">
    {% for project in resume.projects %}
      <div class="card experience-card shadow-sm">
        <div class="card-header card-header-custom">
          </div>
        <div class="card-body py-3">
          {% if project.highlights %}
            <ul class="highlight-list">  <-- Removed list-unstyled
            {% for highlight in project.highlights %}
              <li> {{ highlight | markdownify }}</li>  <-- Removed icon Liquid
            {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% endif %}

    {% comment %} Academic Achievements Section (Icons removed, compact spacing) {% endcomment %}
    {% if resume.awards.size > 0 %}
    <h2 class="year mt-3">Academic Achievements</h2>
    <hr class="resume-section-divider">
      <ul class="highlight-list"> <-- Removed list-unstyled
      {% for award in resume.awards %}
        <li class="mb-0">
          {% if award.url %}
            <a href="{{ award.url }}" target="_blank">
          {% endif %}
          <strong>{{ award.title }}</strong>
          {% if award.url %}
            </a>
          {% endif %}
          {% if award.date %}({{ award.date }}){% endif %}
          {% if award.summary %}: {{ award.summary | markdownify }}{% endif %}
        </li>
      {% endfor %}
      </ul>
    {% endif %}

    {% comment %} Skills Section (No bullets needed for this section) {% endcomment %}
    {% if resume.skills.size > 0 %}
    <h2 class="year mt-3">Skills</h2>
    <hr class="resume-section-divider">
      <ul class="list-unstyled">
      {% for skill in resume.skills %}
        <li class="mb-1" style="font-size: 0.85rem;">
          <strong>{{ skill.name }}:</strong> {{ skill.keywords | join: ", " }}
        </li>
      {% endfor %}
      </ul>
    {% endif %}

  </article>

</div>